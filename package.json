{
  "name": "reflex-router",
  "version": "0.5.8",
  "description": "Orchestration layer for Claude Code: a loopback proxy that asks a fast decision model how much reasoning a piece of work needs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyacivan/reflex-router.git"
  },
  "bugs": {
    "url": "https://github.com/ziyacivan/reflex-router/issues"
  },
  "homepage": "https://github.com/ziyacivan/reflex-router#readme",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "llm",
    "router",
    "model-routing",
    "proxy",
    "cli",
    "cost",
    "typesafe",
    "jev"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "reflex": "bin/reflex.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "THIRD_PARTY.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:versions": "node scripts/gen-tested-versions.mjs",
    "test": "npm run typecheck && npm run lint && node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
